<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GVP Module IX — Signal Management Training</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,600;0,700;1,300&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0a1628;
    --navy-light: #112240;
    --blue: #1a4f8a;
    --accent: #00d4ff;
    --accent2: #ff6b35;
    --warn: #ffd166;
    --green: #06d6a0;
    --red: #ef233c;
    --text: #e8edf5;
    --text-muted: #8ba0bc;
    --border: rgba(0,212,255,0.15);
    --card: rgba(17,34,64,0.8);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--navy);
    color: var(--text);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    overflow-x: hidden;
  }

  /* ── HEADER ── */
  .header {
    background: linear-gradient(135deg, #0a1628 0%, #112240 50%, #0d2444 100%);
    border-bottom: 1px solid var(--border);
    padding: 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo-badge {
    background: var(--accent);
    color: var(--navy);
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 600;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 3px;
    letter-spacing: 1px;
  }
  .logo-text {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.5px;
  }
  .logo-sub {
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'IBM Plex Mono', monospace;
  }
  .header-meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--text-muted);
    text-align: right;
  }
  .status-dot {
    display: inline-block;
    width: 7px; height: 7px;
    background: var(--green);
    border-radius: 50%;
    margin-right: 5px;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%,100% { opacity:1; } 50% { opacity:0.3; }
  }

  /* ── NAV TABS ── */
  .nav-tabs {
    background: var(--navy-light);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }
  .nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    gap: 0;
  }
  .tab-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    padding: 12px 20px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
    white-space: nowrap;
    letter-spacing: 0.5px;
  }
  .tab-btn:hover { color: var(--accent); }
  .tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    background: rgba(0,212,255,0.05);
  }

  /* ── MAIN ── */
  .main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 32px 80px;
  }

  .section { display: none; }
  .section.active { display: block; }

  /* ── HERO ── */
  .hero {
    background: linear-gradient(135deg, rgba(17,34,64,0.9), rgba(26,79,138,0.3));
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 40px;
    margin-bottom: 32px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: 'IX';
    position: absolute;
    right: -20px; top: -40px;
    font-size: 200px;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 600;
    color: rgba(0,212,255,0.04);
    line-height: 1;
  }
  .hero-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 2px;
    margin-bottom: 12px;
  }
  .hero h1 {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 12px;
    color: #fff;
  }
  .hero h1 span { color: var(--accent); }
  .hero p {
    color: var(--text-muted);
    max-width: 700px;
    font-size: 15px;
  }
  .hero-chips {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    flex-wrap: wrap;
  }
  .chip {
    background: rgba(0,212,255,0.1);
    border: 1px solid rgba(0,212,255,0.25);
    color: var(--accent);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }

  /* ── CARDS ── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-bottom: 24px; }
  .grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-bottom: 24px; }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
  }
  .card-accent { border-left: 3px solid var(--accent); }
  .card-warn { border-left: 3px solid var(--warn); }
  .card-green { border-left: 3px solid var(--green); }
  .card-red { border-left: 3px solid var(--red); }
  .card-orange { border-left: 3px solid var(--accent2); }

  .card h3 {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    color: var(--text);
  }
  .card h3 .icon { margin-right: 6px; }
  .card p { color: var(--text-muted); font-size: 13px; }

  /* ── SECTION TITLES ── */
  .section-title {
    font-size: 11px;
    font-family: 'IBM Plex Mono', monospace;
    color: var(--accent);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .section-h2 {
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
  }
  .section-desc {
    color: var(--text-muted);
    font-size: 14px;
    margin-bottom: 28px;
    max-width: 800px;
  }

  /* ── PROCESS FLOW ── */
  .process-flow {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-bottom: 32px;
    overflow-x: auto;
    padding-bottom: 8px;
  }
  .pf-step {
    flex: 1;
    min-width: 140px;
    background: var(--card);
    border: 1px solid var(--border);
    padding: 20px 16px;
    position: relative;
    cursor: pointer;
    transition: all 0.2s;
  }
  .pf-step:first-child { border-radius: 8px 0 0 8px; }
  .pf-step:last-child { border-radius: 0 8px 8px 0; }
  .pf-step:hover { background: rgba(0,212,255,0.08); border-color: var(--accent); }
  .pf-step.active-step { background: rgba(0,212,255,0.12); border-color: var(--accent); }
  .pf-step + .pf-step { border-left: none; }
  .pf-arrow {
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: var(--navy);
    border: 1px solid var(--accent);
    border-radius: 50%;
    width: 22px; height: 22px;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px;
    color: var(--accent);
  }
  .pf-num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .pf-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }
  .pf-sub {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 4px;
    font-family: 'IBM Plex Mono', monospace;
  }

  /* ── STEP DETAIL PANEL ── */
  .step-detail {
    background: rgba(0,212,255,0.06);
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 28px;
    margin-bottom: 24px;
    display: none;
  }
  .step-detail.visible { display: block; }
  .step-detail h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .step-detail .sub { color: var(--text-muted); font-size: 12px; margin-bottom: 16px; font-family: 'IBM Plex Mono', monospace; }

  /* ── TABLES ── */
  .tbl-wrap { overflow-x: auto; margin: 16px 0; }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  th {
    background: rgba(0,212,255,0.12);
    color: var(--accent);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 1px;
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  td {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    color: var(--text-muted);
    vertical-align: top;
  }
  td strong { color: var(--text); }
  tr:hover td { background: rgba(255,255,255,0.02); }

  /* ── CASE BOXES ── */
  .case-box {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 20px;
    overflow: hidden;
  }
  .case-header {
    background: rgba(0,212,255,0.08);
    border-bottom: 1px solid var(--border);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }
  .case-header h4 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }
  .case-header .badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    padding: 2px 10px;
    border-radius: 20px;
    border: 1px solid;
  }
  .badge-signal { color: var(--accent2); border-color: var(--accent2); }
  .badge-refuted { color: var(--text-muted); border-color: var(--text-muted); }
  .badge-confirmed { color: var(--green); border-color: var(--green); }
  .badge-ongoing { color: var(--warn); border-color: var(--warn); }
  .case-body { padding: 20px; display: none; }
  .case-body.open { display: block; }

  /* ── DISPROPORTIONALITY ── */
  .metric-row {
    display: flex;
    gap: 16px;
    margin: 16px 0;
    flex-wrap: wrap;
  }
  .metric-card {
    background: var(--navy);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 16px 20px;
    flex: 1;
    min-width: 160px;
    text-align: center;
  }
  .metric-val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 26px;
    font-weight: 600;
    color: var(--accent);
  }
  .metric-label {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 4px;
    font-family: 'IBM Plex Mono', monospace;
  }
  .metric-card.warn .metric-val { color: var(--warn); }
  .metric-card.green .metric-val { color: var(--green); }
  .metric-card.red .metric-val { color: var(--red); }

  /* ── CODE BLOCKS ── */
  .code-block {
    background: #060d1a;
    border: 1px solid rgba(0,212,255,0.2);
    border-radius: 6px;
    padding: 16px 20px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #7ec8e3;
    margin: 12px 0;
    overflow-x: auto;
    line-height: 1.8;
  }
  .code-block .cm { color: #4a6a8a; }
  .code-block .ck { color: var(--accent); }
  .code-block .cv { color: var(--warn); }
  .code-block .cs { color: var(--green); }

  /* ── TIMELINE ── */
  .timeline { padding: 8px 0; }
  .tl-item {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
    position: relative;
  }
  .tl-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 36px;
    flex-shrink: 0;
  }
  .tl-dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--navy);
    outline: 2px solid var(--accent);
    flex-shrink: 0;
    margin-top: 4px;
  }
  .tl-dot.warn { background: var(--warn); outline-color: var(--warn); }
  .tl-dot.red { background: var(--red); outline-color: var(--red); }
  .tl-dot.green { background: var(--green); outline-color: var(--green); }
  .tl-line {
    width: 1px;
    flex: 1;
    background: var(--border);
    margin-top: 4px;
  }
  .tl-content h4 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }
  .tl-content p { font-size: 12px; color: var(--text-muted); }
  .tl-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--accent);
    margin-bottom: 3px;
  }

  /* ── ALERT BOXES ── */
  .alert {
    border-radius: 6px;
    padding: 14px 18px;
    margin: 14px 0;
    font-size: 13px;
    border: 1px solid;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .alert-info { background: rgba(0,212,255,0.07); border-color: rgba(0,212,255,0.25); color: var(--text-muted); }
  .alert-warn { background: rgba(255,209,102,0.07); border-color: rgba(255,209,102,0.3); color: #e8d080; }
  .alert-red { background: rgba(239,35,60,0.07); border-color: rgba(239,35,60,0.3); color: #f08090; }
  .alert-green { background: rgba(6,214,160,0.07); border-color: rgba(6,214,160,0.3); color: #70e8c0; }
  .alert .icon { font-size: 16px; flex-shrink: 0; }

  /* ── TOGGLE LIST ── */
  .toggle-item {
    border: 1px solid var(--border);
    border-radius: 6px;
    margin-bottom: 8px;
    overflow: hidden;
  }
  .toggle-head {
    padding: 12px 16px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    background: var(--card);
    transition: background 0.2s;
  }
  .toggle-head:hover { background: rgba(0,212,255,0.06); }
  .toggle-body {
    padding: 0 16px;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s;
    font-size: 13px;
    color: var(--text-muted);
    background: rgba(0,0,0,0.2);
  }
  .toggle-body.open {
    max-height: 1000px;
    padding: 14px 16px;
  }
  .chevron { transition: transform 0.3s; }
  .chevron.open { transform: rotate(180deg); }

  /* ── PROGRESS BAR ── */
  .prog-row { margin: 10px 0; }
  .prog-label { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted); margin-bottom: 5px; }
  .prog-bar { height: 6px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden; }
  .prog-fill { height: 100%; border-radius: 3px; transition: width 1s ease; }
  .prog-accent { background: var(--accent); }
  .prog-warn { background: var(--warn); }
  .prog-green { background: var(--green); }
  .prog-red { background: var(--red); }

  /* ── DECISION TREE ── */
  .dtree {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
    margin: 16px 0;
  }
  .dt-q {
    background: rgba(0,212,255,0.1);
    border: 1px solid var(--accent);
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 14px;
    text-align: center;
  }
  .dt-row { display: flex; gap: 14px; margin-bottom: 14px; }
  .dt-yes {
    flex: 1;
    background: rgba(6,214,160,0.08);
    border: 1px solid rgba(6,214,160,0.3);
    border-radius: 6px;
    padding: 12px;
  }
  .dt-no {
    flex: 1;
    background: rgba(239,35,60,0.08);
    border: 1px solid rgba(239,35,60,0.25);
    border-radius: 6px;
    padding: 12px;
  }
  .dt-label { font-size: 10px; font-family: 'IBM Plex Mono', monospace; letter-spacing: 1px; margin-bottom: 6px; }
  .dt-yes .dt-label { color: var(--green); }
  .dt-no .dt-label { color: var(--red); }
  .dt-text { font-size: 12px; color: var(--text-muted); }

  /* ── FOOTER ── */
  .footer {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    border-top: 1px solid var(--border);
    margin-top: 40px;
    letter-spacing: 0.5px;
  }

  @media (max-width: 900px) {
    .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
    .main { padding: 20px 16px 60px; }
    .hero { padding: 28px 20px; }
    .hero h1 { font-size: 22px; }
    .process-flow { flex-direction: column; }
    .pf-step { border-radius: 6px !important; border: 1px solid var(--border) !important; margin-bottom: 4px; }
    .pf-arrow { display: none; }
  }
</style>
</head>
<body>

<!-- HEADER -->
<header class="header">
  <div class="header-inner">
    <div class="logo">
      <div class="logo-badge">EMA GVP</div>
      <div>
        <div class="logo-text">Signal Management Training Platform</div>
        <div class="logo-sub">Module IX · Rev. July 2023</div>
      </div>
    </div>
    <div class="header-meta">
      <span class="status-dot"></span>TRAINING MODE ACTIVE<br>
      Pharmacovigilance System
    </div>
  </div>
</header>

<!-- NAV TABS -->
<nav class="nav-tabs">
  <div class="nav-inner">
    <button class="tab-btn active" onclick="showTab('overview')">01 · Overview</button>
    <button class="tab-btn" onclick="showTab('process')">02 · Process Flow</button>
    <button class="tab-btn" onclick="showTab('detection')">03 · Detection</button>
    <button class="tab-btn" onclick="showTab('validation')">04 · Validation</button>
    <button class="tab-btn" onclick="showTab('assessment')">05 · Assessment</button>
    <button class="tab-btn" onclick="showTab('cases')">06 · Real Cases</button>
    <button class="tab-btn" onclick="showTab('tools')">07 · Tools & Methods</button>
